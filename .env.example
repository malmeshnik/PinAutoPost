DJANGO_SECRET_KEY=django-insecure-your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TELEGRAM_BOT_TOKEN=your_bot_token
# For group chat: invite bot to group, send a message, then get chat_id via https://api.telegram.org/bot<TOKEN>/getUpdates
# Group chat_id starts with minus sign (e.g., -1001234567890)
TELEGRAM_ADMIN_CHAT_ID=your_chat_id_or_group_id
POSTGRES_DB=pinterest_db
POSTGRES_USER=pinterest_user
POSTGRES_PASSWORD=pinterest_pass
DB_HOST=localhost
DB_PORT=5432
